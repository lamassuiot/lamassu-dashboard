[request_definition]
r = sub, obj, act

[policy_definition]
p = sub, obj, act, eft

[role_definition]
# Primary
g = _, _
# Audit
g2 = _, _
# Emergency
g3 = _, _

[policy_effect]
e = some(where (p.eft == allow)) && !some(where (p.eft == deny))

[matchers]
m = (g(r.sub, p.sub) || g2(r.sub, p.sub) || g3(r.sub, p.sub)) && (r.act == p.act || p.act == "*") && (keyMatch(r.obj, p.obj) || p.obj == "*")
